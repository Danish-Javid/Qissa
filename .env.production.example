# Production environment for qissa.online.
#
#   cp .env.production.example .env.production   # then fill in the secrets
#
# This file is committed; .env.production is NOT (see .gitignore). Never put a
# real key in this file.

NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Set by docker-compose.prod.yml from POSTGRES_PASSWORD; listed here so the
# variable is discoverable. Generate one with:  openssl rand -base64 24
POSTGRES_PASSWORD=

# Mandatory behind HTTPS. A browser drops a Secure cookie over plain HTTP, so
# this being wrong logs every parent out rather than failing loudly.
COOKIE_SECURE=true

# Empty = same-origin only, which is correct: the PWA is served by this same
# server. Only add an origin here if a separate front end is ever deployed.
CORS_ORIGINS=

# mock needs no keys and is fully functional. Switch to alibaba or azure once
# the corresponding key below is set.
PROVIDER_MODE=mock

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com
QWEN_STORY_MODEL=qwen-max
QWEN_HOTPATH_MODEL=qwen-flash
COSYVOICE_MODEL=cosyvoice-v2
WANX_MODEL=wanx2.1-t2i-turbo

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_STORY_DEPLOYMENT=gpt-5.5
AZURE_STORY_REASONING_EFFORT=low
AZURE_STORY_TIMEOUT_MS=45000
AZURE_ASR_DEPLOYMENT=mai-transcribe-1.5
AZURE_TTS_VOICE=en-US-Iris:MAI-Voice-2
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_KEY=
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=
AZURE_IMAGE_MODEL=FLUX.2-pro

AUDIO_RETENTION_DAYS=30
SESSION_CAP_MINUTES=15
DAILY_STORY_BUDGET_PER_CHILD=40

# CHANGE BOTH before the site is public. The defaults are published in this
# repository, so leaving them is the same as having no password at all.
SEED_PARENT_EMAIL=
SEED_PARENT_PASSWORD=
