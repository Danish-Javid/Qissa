{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Browser target: DOM libs, JSX transform, bundler resolution (Vite).
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "types": ["vite/client", "vite-plugin-pwa/client"],
    // The web app consumes @qissa/core straight from its TypeScript source
    // (aliased in vite.config.ts) so the browser bundle never waits on a
    // separate core build during development.
    "paths": {
      "@qissa/core": ["../core/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
