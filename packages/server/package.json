{
  "name": "@qissa/server",
  "version": "0.1.0",
  "private": true,
  "description": "Qissa API — Fastify 5, Prisma + PostgreSQL, provider abstraction with mock, Alibaba Cloud and Azure AI Foundry implementations. All vendor keys live here; nothing reaches the browser.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "build": "npm run db:generate && tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "pretest": "npm run db:generate",
    "test": "vitest run",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "seed": "tsx src/seed/seed.ts",
    "verify:providers": "tsx src/scripts/verify-providers.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^11.0.2",
    "@fastify/static": "^10.1.3",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "~6.19.0",
    "@qissa/core": "*",
    "fastify": "^5.5.0",
    "prisma": "~6.19.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}
