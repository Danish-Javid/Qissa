# ============================================================================
# Qissa environment configuration — COPY this file to .env and fill it in.
# SECURITY RULES:
#   1. .env is git-ignored. Never commit real values.
#   2. Nothing in this file may ever reach the browser bundle. The web app
#      talks to the server only; vendors are called server-side.
#   3. Rotate any key that has been shared in chat, email or screenshots.
# ============================================================================

# --- Runtime ----------------------------------------------------------------
# NODE_ENV: "production" enables Secure cookies and stricter defaults.
NODE_ENV=development
PORT=3000
# Log level for the Fastify/Pino logger: fatal | error | warn | info | debug
LOG_LEVEL=info

# --- Database ---------------------------------------------------------------
# PostgreSQL 16 (provided by docker-compose.yml as service "db").
DATABASE_URL=postgresql://qissa:qissa@localhost:5432/qissa?schema=public

# --- Sessions & CSRF ---------------------------------------------------------
# Set to true ONLY when served over HTTPS (reverse proxy / production).
# Secure cookies are rejected by browsers over plain HTTP, so keep false locally.
# MANDATORY in production: the server REFUSES TO BOOT with NODE_ENV=production
# and COOKIE_SECURE=false. The session cookie is the only authentication factor,
# and app.ts also drops HSTS in that state, so nothing would upgrade the
# connection -- a boot that looks healthy would be serving cookies over HTTP.
COOKIE_SECURE=false
# Comma-separated allowlist of browser origins for CORS. Same-origin deployments
# can leave this empty; the server then allows only same-origin requests.
CORS_ORIGINS=
# Comma-separated IPs/CIDRs permitted to set X-Forwarded-For. EMPTY = trust
# nobody, so the client IP is the socket's own address.
# The rate limiter buckets by client IP. Trusting every hop lets a caller send a
# random X-Forwarded-For per request and walk straight through both the global
# ceiling and the 10/min credential cap -- so set this ONLY when a reverse proxy
# genuinely fronts the app, and list just that proxy (its address or the compose
# subnet). If the app port is published directly, leave it empty.
TRUSTED_PROXY_NETS=
# Stage/judging surface: POST /api/demo/* and GET /api/metrics-demo.
# Empty (default) derives the answer from NODE_ENV -- ON for development and the
# test suite, OFF for production, where the routes are not registered at all.
# Seeding drives PAID vendor generations and the metrics card reports
# platform-wide aggregates to any signed-in parent, so forcing this "true" on a
# public deployment is a deliberate act, not a convenience.
DEMO_SURFACE=

# --- Provider selection ------------------------------------------------------
# Which provider set serves story / ASR / TTS / image generation.
#   mock     — deterministic offline implementations (default; no keys needed,
#              works with the venue Wi-Fi unplugged)
#   alibaba  — Alibaba Cloud Model Studio (Qwen, Paraformer, CosyVoice, Wanx);
#              requires DASHSCOPE_API_KEY below
#   azure    — Azure AI Foundry (GPT-5.5, Whisper, gpt-4o-mini-tts, FLUX.2 pro);
#              requires the AZURE_* values below
PROVIDER_MODE=mock

# --- Alibaba Cloud Model Studio (Bailian / DashScope) ------------------------
# Leave blank to stay on mock providers. Never prefix-expose this to the client.
DASHSCOPE_API_KEY=
# Regional endpoint. The international endpoint is the default for Pakistan.
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com
# Model names — override only if the onboarding pack names different models.
QWEN_STORY_MODEL=qwen-max
QWEN_HOTPATH_MODEL=qwen-flash
COSYVOICE_MODEL=cosyvoice-v2
WANX_MODEL=wanx2.1-t2i-turbo

# --- Azure AI Foundry (PROVIDER_MODE=azure) ----------------------------------
# One multi-service AI Foundry resource covers all four capabilities. Find the
# endpoints under Keys and Endpoint of the resource; the api-key pair is
# usually shared between the openai.azure.com and api.cognitive.microsoft.com
# hosts of the same resource.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
# Deployment names exactly as created in the Foundry portal.
AZURE_STORY_DEPLOYMENT=gpt-5.5
# Reasoning effort for the story call. gpt-5.5 accepts none|low|medium|high|
# xhigh (NOT 'minimal'); 'low' is the latency/quality sweet spot. Empty omits it.
AZURE_STORY_REASONING_EFFORT=low
# Ceiling (ms) for the BACKGROUND prefetch generation. The child-facing tap
# uses a short 9s grace in story-engine and fails fast to the vetted ladder.
AZURE_STORY_TIMEOUT_MS=90000
# Speech (ASR + TTS) rides the Azure Speech REST API, not OpenAI-style
# deployments: ASR is fast transcription with enhancedMode.model, TTS is SSML
# whose voice name carries the model. Both are region-locked in preview, so
# the region below is part of the URL, not a hint.
AZURE_ASR_DEPLOYMENT=mai-transcribe-1.5
AZURE_TTS_VOICE=en-US-Iris:MAI-Voice-2
AZURE_SPEECH_REGION=eastus
# Empty reuses AZURE_OPENAI_API_KEY. Set only if speech lives on a separate
# resource from the story deployment.
AZURE_SPEECH_KEY=
# FLUX.2 [pro] (Foundry Models, BFL provider API) on the cognitive-services
# host of the same resource: https://<resource>.api.cognitive.microsoft.com
AZURE_AI_ENDPOINT=https://<your-resource>.services.ai.azure.com
AZURE_AI_API_KEY=
AZURE_IMAGE_MODEL=FLUX.2-pro

# --- Child-voice privacy (NFR-3) ----------------------------------------------
# Days raw audio is kept before the retention job deletes it. 0 deletes
# immediately after processing. Shown to the parent at consent time — it must
# match what we say on stage.
AUDIO_RETENTION_DAYS=30

# --- Session cap ---------------------------------------------------------------
# Hard cap for a child session in minutes (FR-H.1). The orchestrator enforces
# this server-side; the client cannot extend it.
SESSION_CAP_MINUTES=15
# Vendor story generations allowed per child per rolling 24 hours. Reaching it
# is not an error: the engine skips the paid rung and serves the same vetted
# ladder it uses when a vendor is down, so a child still reads. 0 = never call
# the generator at all (a zero-spend rehearsal).
DAILY_STORY_BUDGET_PER_CHILD=40

# --- Demo account (created by `npm run seed`) ----------------------------------
# The email is not a secret. The password is, and this repository is PUBLIC -- so
# it deliberately has no default. Leave SEED_PARENT_PASSWORD empty and the seed
# generates a strong random password and prints it exactly once. An explicit
# value must be at least 10 characters, the same floor registration enforces.
# Note the seeded parent also carries voice consent, so a guessable password
# here exposes retained child audio, not just a dashboard.
SEED_PARENT_EMAIL=demo@qissa.app
SEED_PARENT_PASSWORD=

# --- Design review (development tooling — NOT part of the running app) ---------
# `npm run review` sends a written brief plus the pedagogy and pipeline SOURCE
# to a frontier model and prints back a critical feature review. It is a desk
# tool: it costs real money, it is never called by the server, and it is
# deliberately absent from config.ts's validated environment so it can never
# become part of the runtime contract.
#
# Leave the key empty and the script explains what to set instead of failing
# obscurely. Anything sent here leaves your machine — the brief is product
# strategy, so send it knowingly.
#
# ASTRA_BASE_URL accepts either shape:
#   OpenAI          https://api.openai.com/v1
#   Azure Foundry   https://<resource>.services.ai.azure.com
# You can paste the PROJECT endpoint the Foundry portal shows you
# (…/api/projects/<project>) — the script trims it back to the resource host
# and appends /openai/v1, because the project URL is the SDK control plane and
# posting completions to it 404s. Azure hosts authenticate with an api-key
# header; everything else uses a bearer token. Both are handled.
#
# ASTRA_MODEL is the model id on OpenAI, but the DEPLOYMENT NAME on Azure —
# check the portal, it is often not identical to the model id.
ASTRA_BASE_URL=https://api.openai.com/v1
ASTRA_API_KEY=
ASTRA_MODEL=gpt-6-astra

# --- Personalized video (@qissa/video, Remotion) -----------------------------
#
# The "song of her own" surface: one sound from this child's learner model, the
# words she can already decode, her own pictures, rendered to an MP4 a parent
# can save and send. The script is compiled from the phonics scope — no model
# writes any of it.
#
# OFF BY DEFAULT, for two reasons that are both worth knowing before you turn
# it on:
#
#  1. LICENCE. Rendering uses Remotion, which is free for individuals and for
#     companies of up to three people. A for-profit company of four or more
#     needs a paid company licence — for automated rendering that is $0.01 per
#     render with a $100/month minimum. Nothing here checks or enforces that;
#     it is on whoever deploys.
#     https://www.remotion.dev/docs/license/pricing
#
#  2. THE IMAGE. Remotion drives a headless Chrome and does not run on Alpine
#     (musl). The default Docker target is alpine and CANNOT render. Build the
#     glibc target instead:  docker build --target runtime-video .
#
# With PROVIDER_MODE=mock this still produces a real, watchable MP4 using the
# offline pictogram renderer and silent narration — useful for checking layout
# and timing without spending anything.
VIDEO_ENABLED=false
#
# Render workers. Remotion counts the HOST's cores, so inside a CPU-limited
# container it oversubscribes the cgroup and thrashes — set this to the limit
# you actually gave the container. Empty lets Remotion choose, which is the
# right answer on a dev machine.
VIDEO_RENDER_CONCURRENCY=
